type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRecord = 
 record {
   grantedAt: int;
   role: Role;
 };
type UploadError = 
 variant {
   chunkOutOfOrder;
   invalidContentType;
   magicByteMismatch;
   notFound;
   sizeMismatch;
   svgNotAllowed;
   tooLarge;
   tooManyImages;
   unauthorized;
   uploadExpired;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: HttpRequestResult;
 };
type Token = 
 variant {
   ICP;
   ckUSDC;
 };
type SweepSubaccountResult = 
 record {
   blockIndex: opt nat;
   error: opt text;
   subaccountHex: text;
   subaccountIndex: nat;
 };
type SweepResult = 
 record {
   blockIndex: opt nat;
   error: opt text;
   reference: opt text;
 };
type SweepError = 
 variant {
   invalidConfig: text;
   ledgerError: text;
   sweepFailed: text;
   unauthorized;
 };
type SubmissionRecord = 
 record {
   discipline: Discipline;
   email: text;
   id: text;
   link: text;
   marketingConsent: bool;
   marketingConsentAt: opt int;
   message: opt text;
   name: text;
   submittedAt: int;
 };
type SubmissionInput = 
 record {
   discipline: Discipline;
   email: text;
   honeypot: text;
   link: text;
   marketingConsent: bool;
   marketingConsentAt: opt int;
   message: opt text;
   name: text;
 };
type SubmissionError = 
 variant {
   honeypot;
   invalidInput: text;
   invalidResponse: text;
   notConfigured: text;
   outcallFailed: text;
   rateLimited;
 };
type SubaccountBalanceResult = 
 record {
   balance: nat;
   subaccountHex: text;
   subaccountIndex: nat;
 };
type StreamingStrategy = variant {
                           Callback:
                            record {
                              callback: StreamingCallback;
                              token: StreamingCallbackToken;
                            };};
type StreamingCallbackToken = 
 record {
   content_encoding: text;
   index: nat;
   key: text;
   sha256: opt blob;
 };
type StreamingCallbackResponse = 
 record {
   body: blob;
   token: opt StreamingCallbackToken;
 };
type StreamingCallback = func (StreamingCallbackToken) ->
                          (StreamingCallbackResponse) query;
type StorageStats = 
 record {
   count: nat;
   totalBytes: nat;
 };
type ShippingStatus = 
 variant {
   pending;
   shipped;
 };
type Role = 
 variant {
   admin;
   owner;
   staff;
 };
type ResumeInfo = 
 record {
   deposit: opt DepositInfo;
   expiresAt: int;
   reference: text;
   remainingNs: int;
   status: CryptoPaymentStatus;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_9 = 
 variant {
   err: SubmissionError;
   ok;
 };
type Result_8 = 
 variant {
   err: CryptoPaymentError;
   ok: nat;
 };
type Result_7 = 
 variant {
   err: RecoveryError;
   ok: SweepResult;
 };
type Result_6 = 
 variant {
   err: SweepError;
   ok: SweepSubaccountResult;
 };
type Result_5 = 
 variant {
   err: ConsentError;
   ok;
 };
type Result_4 = 
 variant {
   err: CategoryError;
   ok: Category;
 };
type Result_3 = 
 variant {
   err: text;
   ok;
 };
type Result_26 = 
 variant {
   err: PaymentServiceError;
   ok: PaymentStatus;
 };
type Result_25 = 
 variant {
   err: PaymentServiceError;
   ok: CheckoutSession;
 };
type Result_24 = 
 variant {
   err: PaymentError;
   ok: CheckoutSession;
 };
type Result_23 = 
 variant {
   err: OrderError;
   ok: CreateOrderResult;
 };
type Result_22 = 
 variant {
   err: RecoveryError;
   ok: RecheckResult;
 };
type Result_21 = 
 variant {
   err: ConsentError;
   ok: ConsentListExport;
 };
type Result_20 = 
 variant {
   err: CryptoPaymentError;
   ok: DepositInfo;
 };
type Result_2 = 
 variant {
   err: PaymentServiceError;
   ok;
 };
type Result_19 = 
 variant {
   err: CryptoPaymentError;
   ok: CryptoPaymentStatus;
 };
type Result_18 = 
 variant {
   err: RecoveryError;
   ok: nat;
 };
type Result_17 = 
 variant {
   err: RecoveryError;
   ok: ResumeInfo;
 };
type Result_16 = 
 variant {
   err: SweepError;
   ok: SubaccountBalanceResult;
 };
type Result_15 = 
 variant {
   err: PaymentError;
   ok;
 };
type Result_14 = 
 variant {
   err: SubmissionError;
   ok: vec SubmissionRecord;
 };
type Result_13 = 
 variant {
   err: CategoryError;
   ok: nat;
 };
type Result_12 = 
 variant {
   err: CategoryError;
   ok;
 };
type Result_11 = 
 variant {
   err: EmailError;
   ok;
 };
type Result_10 = 
 variant {
   err: UploadError;
   ok: text;
 };
type Result_1 = 
 variant {
   err: CryptoPaymentError;
   ok;
 };
type Result = 
 variant {
   err: UploadError;
   ok;
 };
type RecoveryError = 
 variant {
   invalidConfig: text;
   ledgerError: text;
   notCryptoOrder;
   notFound;
   sweepFailed: text;
   unauthorized;
 };
type RecheckResult = 
 record {
   balance: nat;
   error: opt text;
   reference: text;
   status: CryptoPaymentStatus;
 };
type PublicOrderView = 
 record {
   created_at: int;
   currency: text;
   customer_principal: opt principal;
   encrypted_shipping: opt blob;
   has_shipping_details: bool;
   id: nat;
   items: vec OrderItem;
   marketing_consent: bool;
   marketing_consent_at: opt int;
   payment_method: PaymentMethod;
   payment_reference: opt text;
   payment_status: PaymentStatus;
   reference: text;
   shipped_at: opt int;
   shipping: float64;
   shipping_status: ShippingStatus;
   subtotal: float64;
   sweep_note: opt text;
   tax: float64;
   total: float64;
   tracking_number: opt text;
   updated_at: int;
 };
type ProductVariant = 
 record {
   id: text;
   inventory: nat;
   name: text;
   price: nat;
   size: text;
 };
type ProductId = nat;
type Product = 
 record {
   active: bool;
   admin_only: bool;
   category: text;
   created_at: int;
   currency: text;
   description: text;
   id: ProductId;
   images: vec text;
   inventory: nat;
   name: text;
   price: nat;
   slug: text;
   updated_at: int;
   variants: vec ProductVariant;
 };
type PaymentStatus = 
 variant {
   cancelled;
   expired;
   paid;
   pending;
 };
type PaymentServiceError = 
 variant {
   alreadyPaid;
   invalidResponse: text;
   notConfigured: text;
   notFound;
   outcallFailed: text;
   rateLimited;
   unauthorized;
 };
type PaymentServiceConfigView = 
 record {
   tokenSet: bool;
   url: text;
 };
type PaymentMethod = 
 variant {
   card_stripe;
   crypto_ckusdc;
   crypto_icp;
   manual;
 };
type PaymentError = 
 variant {
   invalidOrder;
   paymentFailed: text;
 };
type OrderRecoveryView = 
 record {
   amountOwed: nat;
   depositAccount: opt DepositAccount;
   expiresAt: opt int;
   liveBalance: nat;
   paymentMethod: PaymentMethod;
   reference: text;
   status: PaymentStatus;
 };
type OrderItem = 
 record {
   name: text;
   product_id: ProductId;
   quantity: nat;
   unit_amount: nat;
   variant_id: text;
 };
type OrderError = 
 variant {
   belowMinimumOrder: nat;
   ckUSDCDisabled;
   emptyOrder;
   invalidPrice: text;
   invalidQuantity;
   outOfStock: record {
                 ProductId;
                 text;
               };
   paymentFailed: text;
   productInactive: ProductId;
   rateLimited;
   tooManyPendingOrders;
   unknownProduct: ProductId;
   unknownVariant: record {
                     ProductId;
                     text;
                   };
 };
type Order = 
 record {
   created_at: int;
   currency: text;
   customer_email: text;
   customer_principal: opt principal;
   encrypted_shipping: opt blob;
   has_shipping_details: bool;
   id: nat;
   items: vec OrderItem;
   marketing_consent: bool;
   marketing_consent_at: opt int;
   payment_method: PaymentMethod;
   payment_reference: opt text;
   payment_status: PaymentStatus;
   reference: text;
   shipped_at: opt int;
   shipping: nat;
   shipping_status: ShippingStatus;
   subtotal: nat;
   sweep_note: opt text;
   tax: nat;
   total: nat;
   tracking_number: opt text;
   updated_at: int;
 };
type LedgerConfig = 
 record {
   canisterId: principal;
   decimals: nat8;
   fee: nat;
 };
type LatePayment = 
 record {
   expectedAmount: nat;
   receivedAmount: nat;
   receivedAt: int;
   reference: text;
   reviewed: bool;
   token: Token;
 };
type HttpResponse = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   status_code: nat16;
   streaming_strategy: opt StreamingStrategy;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpRequest = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   method: text;
   url: text;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type EmailError = 
 variant {
   invalidResponse: text;
   notConfigured: text;
   notFound;
   notShippable;
   outcallFailed: text;
   unauthorized;
 };
type Discipline = 
 variant {
   music;
   other;
   video;
   visualArt;
   writing;
 };
type DepositInfo = 
 record {
   address: principal;
   amountDue: nat;
   decimals: nat8;
   expiresAt: int;
   qrPayload: text;
   reference: text;
   subaccount: blob;
   token: Token;
 };
type DepositAccount = 
 record {
   owner: principal;
   subaccount: blob;
   textAddress: text;
 };
type CryptoPaymentStatus = 
 variant {
   awaiting_payment;
   expired;
   overpayment: record {
                  expected: nat;
                  received: nat;
                };
   paid: record {blockIndex: nat;};
   underpayment: record {
                   expected: nat;
                   received: nat;
                 };
 };
type CryptoPaymentError = 
 variant {
   alreadyPaid;
   belowMinimumOrder: nat;
   expired;
   invalidConfig: text;
   ledgerError: text;
   notCryptoOrder;
   notFound;
   overpayment: record {
                  expected: nat;
                  received: nat;
                };
   sweepFailed: text;
   unauthorized;
   underpayment: record {
                   expected: nat;
                   received: nat;
                 };
 };
type CryptoConfigView = 
 record {
   ckUSDC: LedgerConfig;
   ckUSDCEnabled: bool;
   icp: LedgerConfig;
   minimumOrder: nat;
   treasuryPrincipal: principal;
   treasurySubaccount: opt blob;
 };
type CreateOrderResult = 
 record {
   cancellationToken: opt text;
   order: Order;
   sessionId: opt text;
 };
type CreateOrderItem = 
 record {
   product_id: ProductId;
   quantity: nat;
   variant_id: text;
 };
type CreateOrderInput = 
 record {
   customer_email: text;
   encrypted_shipping: opt blob;
   has_shipping_details: bool;
   items: vec CreateOrderItem;
   marketing_consent: bool;
   payment_method: PaymentMethod;
   session_id: opt text;
 };
type ConsentListExport = record {csv: text;};
type ConsentError = 
 variant {
   alreadyUnsubscribed;
   invalidResponse: text;
   invalidToken;
   notConfigured: text;
   outcallFailed: text;
   rateLimited;
   unauthorized;
 };
type CheckoutSession = 
 record {
   reference: text;
   url: opt text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type CategoryWithCount = 
 record {
   category: Category;
   productCount: nat;
 };
type CategoryId = nat;
type CategoryError = 
 variant {
   emptyName;
   notFound: CategoryId;
   productsReferenced: record {
                         count: nat;
                         slug: text;
                       };
   slugCollision: text;
   targetCategoryNotFound: text;
 };
type Category = 
 record {
   active: bool;
   created_at: int;
   description: opt text;
   id: CategoryId;
   name: text;
   showWhenEmpty: bool;
   slug: text;
   sortOrder: nat;
   updated_at: int;
 };
type AdminOrderView = 
 record {
   amountOwed: nat;
   createdAt: int;
   cryptoStatus: opt CryptoPaymentStatus;
   currency: text;
   customerEmail: text;
   depositAccountText: text;
   itemCount: nat;
   paymentMethod: PaymentMethod;
   reference: text;
   status: PaymentStatus;
   subaccountHex: text;
   sweepNote: opt text;
 };
type AdminOrderDetail = 
 record {
   amountOwed: nat;
   createdAt: int;
   cryptoStatus: opt CryptoPaymentStatus;
   currency: text;
   customerEmail: text;
   depositAccountText: text;
   encryptedShipping: opt blob;
   hasShippingDetails: bool;
   items: vec OrderItem;
   paymentMethod: PaymentMethod;
   reference: text;
   status: PaymentStatus;
   subaccountHex: text;
   sweepNote: opt text;
   updatedAt: int;
 };
service : {
  addAdmin: (p: principal) -> (bool);
  adminCount: () -> (nat) query;
  adminGetOrderDetail: (reference: text) -> (opt AdminOrderDetail) query;
  adminListOrders: (filter: text) -> (vec AdminOrderView) query;
  bootstrapOwner: (p: principal) -> (bool);
  cancelCardOrder: (reference: text) -> (Result_2);
  cancelGuestOrder: (reference: text, cancellationToken: text) -> (Result_2);
  checkCryptoPayment: (reference: text) -> (Result_19);
  claimInitialAdmin: () -> (bool);
  confirmCardPayment: (reference: text) -> (Result_26);
  consentServiceTransform: (input: TransformationInput) ->
   (TransformationOutput) query;
  createCardCheckoutSession: (reference: text, successUrl: text, cancelUrl:
   text) -> (Result_25);
  createCategory: (name: text, description: opt text) -> (Result_4);
  createCheckoutSession: (order: Order) -> (Result_24);
  createOrder: (input: CreateOrderInput) -> (Result_23);
  createProduct: (product: Product) -> (bool);
  deleteCategory: (id: CategoryId) -> (Result_12);
  deleteProductImage: (assetId: text) -> (Result);
  emailTransform: (input: TransformationInput) ->
   (TransformationOutput) query;
  execute: (qJson: text) -> (Result__1) query;
  finishUpload: (uploadId: text, productId: nat) -> (Result_10);
  forceRecheckPayment: (reference: text) -> (Result_22);
  forceSweepOrder: (reference: text) -> (Result_7);
  getApiDoc: () -> (text) query;
  getCanisterId: () -> (principal) query;
  getConsentListCsv: () -> (Result_21);
  getCryptoConfig: () -> (CryptoConfigView) query;
  getCryptoDepositInfo: (reference: text) -> (Result_20) query;
  getCryptoPaymentStatus: (reference: text) -> (Result_19) query;
  getCycleBalance: () -> (nat) query;
  getDashboardData: () -> (text);
  getDefaultSubaccountBalance: () -> (Result_18);
  getEncryptionRecipients: () -> (vec principal) query;
  getFeaturedVideo: () -> (record {
                             embedUrl: text;
                             rawUrl: text;
                           }) query;
  getIbePublicKey: () -> (blob);
  getMinimumOrder: () -> (nat) query;
  getMyEncryptedIbeKey: (transportPublicKey: blob) -> (blob);
  getMyOrders: () -> (vec PublicOrderView) query;
  getMyRole: () -> (opt Role) query;
  getNAKPrice: () -> (text);
  getOrderStatus: (reference: text) -> (opt PublicOrderView) query;
  getPaymentServiceConfig: () -> (PaymentServiceConfigView) query;
  getPaymentStatus: (reference: text) -> (PaymentStatus);
  getPendingOrderConfig: () ->
   (record {
      globalCap: nat;
      perSessionCap: nat;
    }) query;
  getProduct: (slugOrId: text) -> (opt Product) query;
  getProductImageStorageStats: () -> (StorageStats) query;
  getResumeInfo: (reference: text) -> (Result_17) query;
  getSubaccountBalance: (subaccountIndex: nat) -> (Result_16);
  getTokenImage: (chainId: text, tokenAddress: text) -> (text);
  getTokenProfile: (chainId: text, tokenAddress: text) -> (text);
  getTreasuryTokens: () -> (text);
  grantRole: (p: principal, role: Role) -> (bool);
  handlePaymentConfirmation: (payload: text) -> (Result_15);
  http_request: (req: HttpRequest) -> (HttpResponse) query;
  http_request_streaming_callback: (token: StreamingCallbackToken) ->
   (StreamingCallbackResponse) query;
  http_request_update: (req: HttpRequest) -> (HttpResponse) query;
  isAdmin: () -> (bool) query;
  listAdmins: () -> (vec principal);
  listCategories: () -> (vec CategoryWithCount) query;
  listLatePayments: () -> (vec LatePayment);
  listOrdersForRecovery: () -> (vec OrderRecoveryView);
  listProducts: () -> (vec Product) query;
  listSubmissions: () -> (Result_14);
  listUsers: () -> (vec record {
                          principal;
                          UserRecord;
                        });
  markLatePaymentReviewed: (reference: text) -> (bool);
  markOrderShipped: (reference: text, trackingNumber: opt text) ->
   (Result_11);
  paymentServiceTransform: (input: TransformationInput) ->
   (TransformationOutput) query;
  reassignProducts: (fromSlug: text, toSlug: text) -> (Result_13);
  releaseExpiredOrders: () -> (nat);
  releaseExpiredReservations: () -> (nat);
  removeAdmin: (p: principal) -> (bool);
  reorderCategories: (orderedIds: vec CategoryId) -> (Result_12);
  resendConfirmationEmail: (reference: text) -> (Result_11);
  resetAdminForMigration: () -> (bool);
  revokeRole: (p: principal) -> (bool);
  schema: () -> (text) query;
  startUpload: (contentType: text, totalSize: nat) -> (Result_10);
  startVerificationTimer: () -> (bool);
  stopVerificationTimer: () -> (bool);
  submissionServiceTransform: (input: TransformationInput) ->
   (TransformationOutput) query;
  submitSubmission: (input: SubmissionInput) -> (Result_9);
  sweepCryptoToTreasury: (reference: text) -> (Result_8);
  sweepDefaultSubaccount: () -> (Result_7);
  sweepExpiredUploads: () -> ();
  sweepSubaccount: (subaccountIndex: nat) -> (Result_6);
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  unsubscribe: (token: text) -> (Result_5);
  updateCategory: (id: CategoryId, name: text, description: opt text,
   sortOrder: nat, active: bool, showWhenEmpty: bool) -> (Result_4);
  updateFeaturedVideo: (rawUrl: text) -> (Result_3);
  updateLedgerConfig: (token: Token, canisterId: principal, decimals: 
   nat8, fee: nat) -> (Result_1);
  updateMinimumOrder: (minimum: nat) -> (Result_1);
  updatePaymentServiceToken: (token: text) -> (Result_2);
  updatePaymentServiceUrl: (url: text) -> (Result_2);
  updatePendingOrderGlobalCap: (cap: nat) -> (nat);
  updateProduct: (product: Product) -> (bool);
  updateTreasury: ("principal": principal, subaccount: opt blob) ->
   (Result_1);
  uploadChunk: (uploadId: text, index: nat, "blob": blob) -> (Result);
}
